{
  "name": "sculpt-wing-desktop",
  "productName": "Sculpt Wing",
  "version": "0.7.4",
  "description": "Sculpt Wing — controllo WING, rack VST3 e analisi dell’impianto per Mac Apple Silicon",
  "private": true,
  "license": "UNLICENSED",
  "author": "Gianluca Vergalito",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:app": "node scripts/prepare.mjs",
    "prestart": "npm run prepare:app",
    "start": "electron .",
    "test": "node --test --test-timeout=30000 --test-reporter=spec tests/*.test.cjs",
    "pack": "npm run prepare:app && electron-builder --dir --publish never",
    "dist:mac": "npm run build:audio && npm run prepare:app && electron-builder --mac zip --arm64 --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "dist:win": "npm run prepare:app && electron-builder --win --x64 --publish never",
    "build:audio": "node scripts/build-audio.cjs"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "it.sculpt.wing",
    "productName": "Sculpt Wing",
    "artifactName": "Sculpt-Wing-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "app/**",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "publish": null,
    "beforePack": "./scripts/before-pack.cjs",
    "afterPack": "./scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Sculpt Wing usa la rete locale per controllare la WING e inviare comandi OSC a Sculpt Show o altri dispositivi.",
        "LSMultipleInstancesProhibited": true,
        "NSMicrophoneUsageDescription": "Sculpt Wing usa gli ingressi audio USB per i plugin VST3 e per le misure dell’impianto con microfono e segnale di riferimento."
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sculpt Wing"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "../audio-host/build/SculptWingAudio_artefacts/Release/SculptWingAudio.app",
        "to": "audio-host/SculptWingAudio.app",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
